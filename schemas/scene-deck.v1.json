{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://ppt-design.local/schemas/scene-deck.v1.json",
  "title":"Scene Deck v1",
  "type":"object",
  "required":["profile","slides"],
  "properties":{
    "version":{"type":"string"},
    "profile":{"const":"SCENE-DECK-v1"},
    "deck":{"type":"object"},
    "themes":{"type":"object"},
    "slides":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/slide"}}
  },
  "$defs":{
    "slide":{"type":"object","required":["id","elements"],"properties":{"id":{"type":"string"},"theme":{"type":"string"},"background":{"type":"string"},"meta":{"type":"object"},"notes":{"type":"string"},"elements":{"type":"array","items":{"$ref":"#/$defs/element"}}}},
    "element":{"type":"object","required":["type"],"properties":{"id":{"type":"string"},"type":{"enum":["text","rect","roundRect","ellipse","line","connector","image","chart"]},"x":{"type":"number","minimum":0,"maximum":100},"y":{"type":"number","minimum":0,"maximum":100},"w":{"type":"number","minimum":0,"maximum":100},"h":{"type":"number","minimum":0,"maximum":100},"x1":{"type":"number","minimum":0,"maximum":100},"y1":{"type":"number","minimum":0,"maximum":100},"x2":{"type":"number","minimum":0,"maximum":100},"y2":{"type":"number","minimum":0,"maximum":100},"z":{"type":"number"},"text":{"type":"string"},"runs":{"type":"array"},"path":{"type":"string"},"chartType":{"enum":["bar","column","line","pie","doughnut"]},"categories":{"type":"array"},"series":{"type":"array"},"style":{"type":"object"},"visible":{"type":"boolean"}}}
  }
}
