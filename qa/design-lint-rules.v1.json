{
  "version": "1.9",
  "profile": "PPT-DESIGN-AGENT-v1",
  "blocking": [
    "no_primary_message",
    "unreadable_text",
    "slide_reflow_detected",
    "signature_reference_copy_risk",
    "content_hidden_by_font_shrink",
    "object_collision",
    "connector_endpoint_misalignment",
    "prose_in_kpi_value",
    "unaggregated_duplicate_time_categories",
    "internal_metadata_exposed",
    "cross_scope_metric_mixing",
    "generic_headline_after_editorial_pass",
    "causal_language_exceeds_evidence",
    "deck_story_repetition",
    "deck_visual_rhythm_failure",
    "narrative_order_failure",
    "title_chain_failure",
    "deck_length_redundancy",
    "page_overload_requires_split",
    "font_below_readable_floor",
    "density_overload",
    "requires_editorial_reflow",
    "font_below_role_floor",
    "readability_density_overload",
    "readability_requires_editorial_reflow"
  ],
  "rules": {
    "hierarchy": {"id":"L01","primaryCount":1,"maxHierarchyLevels":4,"requirePrimarySecondaryTertiaryDistinction":true},
    "typography": {"id":"L02","maxPrimaryFontSizes":4,"useMultipleEmphasisFactors":true,"avoidAllBold":true,"minReadableFontPt":8.5,"neverShrinkBelowReadableFloor":true},
    "spacing": {"id":"L03","betweenGroupToWithinGroupMinRatio":2.0,"useTokenScale":true,"preferProximityOverExtraBorders":true},
    "color": {"id":"L04","bodyContrastTarget":4.5,"largeTextContrastTarget":3.0,"signalColorSparse":true,"foregroundBackgroundPairRequired":true},
    "clutter": {"id":"L05","maxStrongVisualElements":3,"removeRedundantDecoration":true,"removeRedundantLabels":true},
    "compositionDiversity": {"id":"L06","recentSlideWindow":3,"rejectAccidentalRepeatedSilhouette":true,"allowIntentionalSequenceRepetition":true,"defaultExplorationVariants":3},
    "contentFit": {"id":"L07","densityProfiles":["LOW","MED","HIGH"],"preferPatternChangeBeforeExtremeShrink":true,"moveExcessDetailToStructureOrAppendix":true},
    "originality": {"id":"L08","extractHighLevelGrammar":true,"avoidDistinctiveSignatureLayout":true,"avoidMarksLogosWordmarks":true,"requireNativeDesignSystemExpression":true},
    "fixedCanvasHtml": {"id":"L09","canvasPx":{"width":1600,"height":900},"slideInternalReflow":false,"responsiveTypographyInsideSlide":false,"uniformScaleOnly":true,"catalogUiMayReflow":true},
    "geometryRelations": {"id":"L10","minimumGapPxBetweenTitleAndPrimaryContent":32,"rejectUnexpectedBoundingBoxIntersection":true,"allowOverlapOnlyWhenPatternExplicitlyDeclaresIt":true,"connectorMustTerminateAtTargetBoundary":true,"connectorMustStartAtSourceBoundary":true,"connectorBoundaryTolerancePx":6,"checkConnectorAgainstContainerBorder":true,"checkTextAgainstCardAndChartBounds":true},
    "semanticContentFit": {"id":"L11","kpiPrimaryValueMustBeScalarOrCompactToken":true,"maxKpiValueChars":24,"rejectSentenceInKpiValue":true,"separateValueLabelContext":true,"aggregateRepeatedTimeKeysBeforeChart":true,"rejectInternalSystemMetadataInUserFacingSlides":true,"avoidAdjacentSlidesWithSameEvidenceAndSameCardSilhouette":true,"causalStatusFromEvidenceMustBePreserved":true},
    "editorialStoryFit": {"id":"L12","oneQuestionPerSlide":true,"onePrimaryClaimPerSlide":true,"preferClaimHeadlineOverGenericTopicLabel":true,"suppressUndeclaredCrossSourceMetricComparisons":true,"avoidAdjacentSlidesAnsweringSameQuestionWithSameEvidence":true,"preserveEvidenceCausalStatusInWording":true,"compressAnalyticalProseBeforePatternResolution":true,"storySequenceMustBeExplicit":true},
    "deckNarrativeRhythm": {"id":"L13","titleSequenceMustReadAsStory":true,"avoidAdjacentRepeatedQuestions":true,"avoidAdjacentRepeatedClaims":true,"recentSilhouetteWindow":3,"avoidSameSilhouetteWithinWindow":true,"allowIntentionalSequenceRepetition":true,"preferVisualModeChangeAfterKpi":true,"requireDeckLevelEnergyVariation":true,"preferDecisionOrActionCloseWhenObjectiveRequiresIt":true,"threeDirectionsMustDifferStructurally":true},
    "narrativeSequence": {"id":"L14","objectiveMustResolveToNarrativeArc":true,"detectEvidenceInterpretationOrderInversions":true,"respectSequenceLocks":true,"stableReorderOnly":true,"titleChainMustRemainFactPreserving":true,"titleBridgeMustNotStrengthenCausalStatus":true,"displayHeadlineMustReachRenderedArtifact":true,"preferActionCloseWhenArcRequiresIt":true},
    "deckLengthFit": {"id":"L15","targetSlideCountIsGuidanceNotForced":true,"preferMergeBeforeDroppingUniqueEvidence":true,"splitOverloadedStructuredPagesBeforeFontShrink":true,"dropOnlyExplicitOptionalDuplicatesAutomatically":true,"protectOpeningAndActionClose":true,"doNotMergeConflictingCausalStatus":true,"respectDeckLengthAndSequenceLocks":true,"recordEveryLengthOperation":true,"allAutomaticOperationsMustBeReversible":true,"neverInventEvidenceToFillADeck":true},
    "typographyDensityFit": {"id":"L16","minReadableFontPt":8.5,"guardBeforeRender":true,"safeAutoRaiseAllowed":true,"bodyDensityWarningRatio":0.9,"bodyDensityHardLimitRatio":1.25,"largeDisplayTitlesMayWrapIntentionally":true,"neverResolveOverloadByShrinkingBelowFloor":true,"editorialReflowActions":["shorten_copy","change_pattern","split_page","move_detail_to_appendix"]},
    "readabilityFit": {"id":"L17","systemMetaMinPt":8.5,"kickerMinPt":10,"footnoteMinPt":9.5,"contentLabelMinPt":12,"bodyMinPt":14,"roleAwareFontFloors":true,"readabilityGuardBeforeRender":true,"safeAutoRaiseAllowed":true,"blockWhenRoleFloorWouldOverload":true,"slideTextDensityWarningVisualChars":520,"manyContentTextBoxesWarning":18,"editorialReflowActions":["shorten_copy","change_pattern","split_page","move_detail_to_appendix","diagram_first"]}
  },
  "workflow": ["brief","evidence_input","content_planner","presentation_editor","deck_length_editor","deck_director_sequence","deck_director_rhythm","reference_grammar","three_variations","human_review","resolve_design_system","design_lint","shared_scene_graph","typography_density_guard","readability_guard","render_html_ppt_golden","ppt_safe_qa"]
}
